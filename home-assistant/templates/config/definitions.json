{
  "slots": [
    {
      "slot": "floodlight_1",
      "name": "Floodlight 1",
      "family": "fi",
      "light": {
        "name": "Floodlight 1",
        "state": "{{ (states('input_text.floodlight_1_settings') | from_json({})).get('on', false) }}",
        "turn_on": [
          {
            "action": "script.floodlight_control",
            "data": {
              "slot": "floodlight_1",
              "operation": "on"
            }
          }
        ],
        "turn_off": [
          {
            "action": "script.floodlight_control",
            "data": {
              "slot": "floodlight_1",
              "operation": "off"
            }
          }
        ],
        "additional_options": {
          "availability": "{% set config = (states('input_text.floodlight_1_settings') | from_json({})) %}{{ config.get('target', '') != '' and states(config.get('target', 'binary_sensor.unassigned')) not in ['unknown', 'unavailable'] }}"
        },
        "level": "{{ (states('input_text.floodlight_1_settings') | from_json({})).get('b', 128) }}",
        "hs": "{{ (states('input_text.floodlight_1_settings') | from_json({})).get('hs', [280, 100]) }}",
        "set_level": [
          {
            "action": "script.floodlight_control",
            "data": {
              "slot": "floodlight_1",
              "operation": "brightness",
              "brightness": "{{ brightness }}"
            }
          }
        ],
        "set_hs": [
          {
            "action": "script.floodlight_control",
            "data": {
              "slot": "floodlight_1",
              "operation": "color",
              "hs": "{{ hs }}",
              "brightness": "{{ brightness | default((states('input_text.floodlight_1_settings') | from_json({})).get('b', 128)) }}"
            }
          }
        ]
      },
      "availability": "{% set config = (states('input_text.floodlight_1_settings') | from_json({})) %}{{ config.get('target', '') != '' and states(config.get('target', 'binary_sensor.unassigned')) not in ['unknown', 'unavailable'] }}"
